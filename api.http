### get link with code
GET http://localhost:5001/abc123


### test valid code
POST  http://localhost:5001/links
Content-Type: application/json

{
    "code": "dev123",
    "url": "https://github.com"
}

### test invalid code

POST http://localhost:5001/links
Content-Type: application/json

{
    "code": "d",
    "url": "https://github.com"
}


### test invalid url
POST http://localhost:5001/links
Content-Type: application/json

{
    "code": "qwer123",
    "url": "github.com"
}

###
POST http://localhost:5001/links
Content-Type: application/json

{
    "code": "qwer124",
    "url": "javascript:alert(1)"
}

###
POST http://localhost:5001/links
Content-Type: application/json

{
    "code": "qwer125",
    "url": "file:///C:/test.txt"
}

### test if code health is rejected (all lowercase)
POST http://localhost:5001/links
Content-Type: application/json

{
    "code": "health",
    "url": "https://example.com"
}

### test if code health is rejected (all uppercase)
POST http://localhost:5001/links 
Content-Type: application/json

{
    "code": "HEALTH",
    "url": "https://example.com"
}


### test if code health is rejected (uppercase & lowercase)
POST http://localhost:5001/links
Content-Type: application/json

{
    "code": "hEAlth",
    "url": "https://example.com"
}